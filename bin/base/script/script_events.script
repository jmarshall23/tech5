/*
================================================
	idMover
================================================
*/

// Stops any translational movement.
scriptEvent void stopMoving();

// Stops any rotational movement.
scriptEvent void stopRotating();

// Sets the movement speed. Set this speed before initiating a new move.
scriptEvent void speed( float speed );

// Sets the movement time. Set this time before initiating a new move.
scriptEvent void time( float time );

// Sets the acceleration time. Set this acceleration time before initiating a new move.
scriptEvent void accelTime( float time );

// Sets the deceleration time. Set this deceleration time before initiating a new move.
scriptEvent void decelTime( float time );

// Sets movement time, acceleration time, and deceleration time.
scriptEvent void setParmsForTime( float time, float acceltime, float deceltime );

// Sets movement speed, acceleration time, and deceleration time.
scriptEvent void setParmsForSpeed( float speed, float acceltime, float deceltime );

// Initiates a translation to the position of an entity. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void moveTo( entity ent );

// Initiates a translation to an absolute position. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void moveToPos( vector pos );

// Initiates a translation with the given distance in the given yaw direction. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void move( float angle, float distance );

// Initiates an absolute translation with the given distance in the given yaw direction. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void moveAbsolute( float angle, float distance );

// Initiates an acceleration to the given speed over the given time in seconds.
scriptEvent void accelTo( float speed, float time );

// Initiates a deceleration to the given speed over the given time in seconds.
scriptEvent void decelTo( float speed, float time );

// Initiates a rotation about the given axis by decreasing the current angle towards the  given angle. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void rotateDownTo( int axis, float angle );

// Initiates a rotation about the given axis by increasing the current angle towards the  given angle. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void rotateUpTo( int axis, float angle );

// Initiates a rotation towards the given Euler angles. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void rotateTo( vector angles );

// Initiates a rotation with the given angular speed. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void rotateXYZ( float x, float y, float z );

// 
scriptEvent void rotate( vector angles );

// Initiates a rotation towards the current angles plus the given Euler angles. Uses the current speed/time and acceleration and deceleration settings.
scriptEvent void rotateOnceXYZ( float x, float y, float z );

// 
scriptEvent void rotateOnce( vector angles );

// Initiates a translation back & forth along the given vector with the given speed & phase.
scriptEvent void bob( float speed, float phase, vector depth );

// Initiates a rotation back and forth along the given angles with the given speed & phase.
scriptEvent void sway( float speed, float phase, vector depth );

// Sets the sound to be played when the mover accelerates.
scriptEvent void accelSound( decl sound );

// Sets the sound to be played when the mover decelerates.
scriptEvent void decelSound( decl sound );

// Sets the sound to be played when the moving.
scriptEvent void moveSound( decl sound );

// Enables aligning the mover with the spline direction.
scriptEvent void enableSplineAngles();

// Disables aligning the mover with the spline direction.
scriptEvent void disableSplineAngles();

// Subtracts the initial spline angles to maintain the initial orientation of the mover.
scriptEvent void removeInitialSplineAngles();

// Starts moving along a spline stored on the given entity.
scriptEvent void startSpline( entity splineEntity );

// Starts moving along a spline stored on the given entity, optionally ignore entity rotation and follow spline's initial rotation
scriptEvent void followSpline( entity splineEntity, int ignoreEntityRotation, int followSplineInitialRotation );

// Stops moving along a spline.
scriptEvent void stopSpline();

// Returns true if a mover is moving
scriptEvent int isMoving();

// Returns true if a mover is rotating
scriptEvent int isRotating();

// emit smoke / particles
scriptEvent void emitSmoke( string particle, int timeOffsetSecs, float diversity, vector offset );

// enable influence trail
scriptEvent void enableInfluence();

// disable influence trail
scriptEvent void disableInfluence();

// call this to break the constraint that holds the impaled target to the mover
scriptEvent void breakConstraint();

// call this after breaking the constraint to reset this mover to impale again!
scriptEvent void restConstraint();

// called after this tried to impale an entity to make sure it will not impale an entity while resetting
scriptEvent void impaleFinished();

/*
================================================
	idSplinePathMM
================================================
*/

// get the number of spline children associated with this spline
scriptEvent int getNumSplineChildren();

// get the spline child at a particular index
scriptEvent entity getSplineChild( int index );

// get the next spline child
scriptEvent entity getNextSplineChild( float splineLength );

// get the nearest spline child to a spline length position
scriptEvent entity getClosestSplineChild( float splineLength );

// return the total length of the spline
scriptEvent float getSplineLength();

// find the distance along the spline from a world position, projected onto nearest spline position
scriptEvent float getDistanceAlongPath( vector worldPos, float lastDistance, float searchWidth, float interval );

// get the vector position along a path at a specified distanced(clamped 0.0 to spline length)
scriptEvent vector getPositionAlongPath( float distance );

// get the vector direction/tangent of the spline at a specified distance(clamped 0.0 to spline length)
scriptEvent vector getDirectionAlongPath( float distance );

