*/

// Returns entity from a name
scriptEvent entity findEntity( string newName );

// Returns the name of this entity.
scriptEvent string getName();

// Sets the name of this entity.
scriptEvent void setName( string newName );

// Called when an entity is triggered
scriptEvent void activate( entity activator );

// Causes this entity to activate all it's targets. Similar to how a trigger activates entities. Activator is the entity that caused the action (usually the player).
scriptEvent void activateTargets( entity activator );

// sets this entity activatable or unactivatable
scriptEvent void makeActivatable( boolean activatable );

// Returns the number of entities this entity has targeted.
scriptEvent boolean targetsReady();

// Returns the number of targets.
scriptEvent float numTargets();

// Returns the requested target entity.
scriptEvent entity getTarget( float index );

// Removes the specified entity from the target list. Returns false if not found.
scriptEvent boolean removeTarget( entity target );

// Adds the specified entity to the target list
scriptEvent void addTarget( entity target );

// Clear all entities in the target list
scriptEvent void clearTargets();

// Returns a random targeted entity. Pass in an entity name to skip that entity.
scriptEvent entity randomTarget( string ignore );

// Fixes the position and orientation of this entity relative to another entity, such that when the master entity moves, so does this entity.
scriptEvent void bind( entity master );

// Fixes the position (but not orientation) of this entity relative to another entity, such that when the master entity moves, so does this entity.
scriptEvent void bindPosition( entity master );

// Fixes the position and orientation of this entity relative to a joint on another entity, such that when the master's joint moves, so does this entity.
scriptEvent void bindToJoint( entity master, string animName, string jointName, float orientated );

// Detaches this entity from its master.
scriptEvent void unbind();

// Removes all attached entities from the game.
scriptEvent void removeBinds();

// Sets the owner of this entity. Entity's will never collide with their owner.
scriptEvent void setOwner( entity owner );

// Sets the progression owner of this entity. The progression owner of this entity is notified on removal/use/destruction.
scriptEvent void setProgressionOwner( entity owner );

// Notifies the progression owner of this entity so it can update it's state.
scriptEvent void notifyProgressionOwner();

// Sets the model this entity uses.
scriptEvent void setModel( string modelname );

// returns the model this entity uses.
scriptEvent string getModel();

// Sets the clip model this entity uses.
scriptEvent void setClipModel( string clipModelName );

// Set the contents of the physics object to the specified flags.
scriptEvent void setContents( int contents );

// returns the contents of the entity's physics object.
scriptEvent int getContents();

// adds the specified contents flags to the physics object's existing contents flags.
scriptEvent void addContentsFlag( int contents );

// removes the specified contents flags from the physics object's existing contents flags.
scriptEvent void removeContentsFlag( int contents );

// Set the contents of the physics object to the specified flags.
scriptEvent void setClipMask( int mask );

// returns the contents of the entity's physics object.
scriptEvent int getClipMask();

// adds the specified contents flags to the physics object's existing contents flags.
scriptEvent void addClipMaskFlag( int mask );

// removes the specified contents flags from the physics object's existing contents flags.
scriptEvent void removeClipMaskFlag( int mask );

// Sets the skin this entity uses. Set to "" to turn off the skin.
scriptEvent void setSkin( string skinname );

// Sets shader parms Parm0, Parm1, Parm2, and Parm3 (red, green, blue, and alpha respectively).
scriptEvent void setShaderParms( float parm0, float parm1, float parm2, float parm3 );

// Sets the RGBA color of this entity (shader parms Parm0, Parm1, Parm2, Parm3).
scriptEvent void setColorAndAlpha( float red, float green, float blue, float alpha );

// Sets the RGB color of this entity (shader parms Parm0, Parm1, Parm2).
scriptEvent void setColor( float red, float green, float blue );

// Gets the color of this entity (shader parms Parm0, Parm1, Parm2).
scriptEvent vector getColor();

// Returns true if the entity's model is invisible.
scriptEvent int isHidden();

// Makes this entity invisible.
scriptEvent void hide();

// Makes this entity visible if it has a model.
scriptEvent void show();

// Pre-caches the specified sound shader. Prevents cache hits when playing sound shaders.
scriptEvent void cacheSoundShader( string soundName );

// Plays a specific sound shader on the channel and returns the length of the sound in seconds. This is not the preferred method of playing a sound since you must ensure that the sound is loaded.
scriptEvent float startSoundShader( decl shader, int channel );

// Stops a specific sound shader on the channel.
scriptEvent void stopSound( int channel, int netSync );

// Fades the sound on this entity to a new level over a period of time. Use SND_CHANNEL_ANY for all currently playing sounds.
scriptEvent void fadeSound( int channel, float to, float over );

// Fades pitch on this entity to a new level over a period of time. Units are in semitones.  The Base pitch is zero. Negative is lower and positive is higher. Use SND_CHANNEL_ANY for all currently playing sounds.
scriptEvent void fadePitch( int channel, float to, float over );

// Plays a voiceover on the channel and returns the length of the voice over.
scriptEvent float playVoiceOver( decl voToPlay, int channel, string talkerID );

// change how the entity flashes.
scriptEvent void setHighlight( int hlColor );

// Returns the current world space position of this entity (regardless of any bind parent).
scriptEvent vector getWorldOrigin();

// Sets the current position of this entity (regardless of any bind parent).
scriptEvent void setWorldOrigin( vector org );

// Returns the current position of this entity (relative to bind parent if any).
scriptEvent vector getOrigin();

// Sets the current position of this entity (relative to it's bind parent if any).
scriptEvent void setOrigin( vector org );

// Returns the current orientation of this entity (relative to bind parent if any).
scriptEvent vector getAngles();

// Sets the current orientation of this entity (relative to bind parent if any).
scriptEvent void setAngles( vector ang );

// Returns the current forward vector of this entity's model axis
scriptEvent vector getModelForward();

// Gets the current linear velocity of this entity. The linear velocity of a physics object is a vector that defines the translation of the center of mass in units per second.
scriptEvent void setLinearVelocity( vector velocity );

// Sets the current linear velocity of this entity in units per second. The linear velocity of a physics object is a vector that defines the translation of the center of mass in units per second.
scriptEvent vector getLinearVelocity();

// Gets the current angular velocity of this entity. The angular velocity of a physics object is a vector that passes through the center of mass. The direction of this vector defines the axis of rotation and the magnitude defines the rate of rotation about the axis in radians per second.
scriptEvent void setAngularVelocity( vector velocity );

// Sets the current angular velocity of this entity. The angular velocity of a physics object is a vector that passes through the center of mass. The direction of this vector defines the axis of rotation and the magnitude defines the rate of rotation about the axis in radians per second.
scriptEvent vector getAngularVelocity();

// Gets the size of this entity's bounding box.
scriptEvent vector getSize();

// Gets the minimum corner of this entity's bounding box.
scriptEvent vector getMins();

// Gets the maximum corner of this entity's bounding box.
scriptEvent vector getMaxs();

// Returns true if this entity touches the other entity.
scriptEvent int touches( entity ent );

// Returns this entity to the position stored in the "origin" spawn arg. This is the position the entity was spawned in unless the "origin" key is changed. Note that there is no guarantee that the entity won't be stuck in another entity when moved, so care should be taken to make sure that isn't possible.
scriptEvent void restorePosition();

// Returns the distance of this entity to another entity.
scriptEvent float distanceTo( entity ent );

// Returns the distance of this entity to a point.
scriptEvent float distanceToPoint( vector point );

// Returns the angle (yaw) of this entity to another entity.
scriptEvent float angleTo( entity ent );

// Suspends execution of current thread for one game frame.
scriptEvent void waitFrame();

// Suspends execution of the current thread for the given number of seconds.
scriptEvent void wait( float time );

// Returns true if an entity's script object has a specific function.
scriptEvent int hasFunction( string name );

// Calls a function on this entity's script object.
scriptEvent void callFunction( string name );

// gets the named float variable from the entity's script object
scriptEvent float getScriptObjectFloat( string name );

// gets the named bool variable from the entity's script object
scriptEvent boolean getScriptObjectBool( string name );

// gets the named string variable from the entity's script object
scriptEvent string getScriptObjectString( string name );

// sets the type of script object attached to the entity and initializes it
scriptEvent void setScriptObject( string name );

// returns the name of the type of script object attached to the entity
scriptEvent string getScriptObject();

// Enables or prevents an entity from going dormant.
scriptEvent void setCanBecomeDormant( int enable );

// teleports the entity to a location
scriptEvent void teleport( vector origin, vector angles );

// clamp 'angles' between 'center' +/- 'offset'
scriptEvent vector clampAngles( vector angles, vector center, vector offset );

// calls functionality test on entity
scriptEvent void testFunctionality();

// gets the object class type
scriptEvent string getClass();

// compare class types
scriptEvent boolean isClass( string className );

// compare class type with inheritance
scriptEvent boolean isSpecificClass( string className );

// adds the entity to the remove list
scriptEvent void remove();

// true to enable damage
scriptEvent void setTakesDamage( boolean takesDamage );

// signal threads
scriptEvent void signalEvent( int signal );

/*
================================================
	idScriptList
================================================
*/

// 
scriptEvent entity get( int index );

// 
scriptEvent int size();

// 
scriptEvent void append( entity toAdd );

// 
scriptEvent void appendList( list toAdd );

// 
scriptEvent void insert( entity toAdd, int index );

// 
scriptEvent void erase( int index );

// 
scriptEvent void clear();

// 
scriptEvent void copy( list otherList );

/*
================================================
	idEventReceiver
================================================
*/

// Removes this object from the game.
scriptEvent void remove();

/*
================================================
	idThread
================================================
*/

// Disassociates the thread from it's thread entity and deletes the thread.
scriptEvent void remove();

// Terminates this thread.
scriptEvent void endThread();

// Terminates a thread.
scriptEvent void terminate( int threadHandle );

// Pauses the current thread.
scriptEvent void pause();

// Suspends execution of the current thread for the given number of seconds.
scriptEvent void wait( float time );

// Suspends execution for one game frame.
scriptEvent void waitFrame();

// Waits for the given entity to complete it's move.
scriptEvent void waitFor( entity ent );

// Waits for the given thread to terminate.
scriptEvent void waitForThread( int threadHandle );

// 
scriptEvent void waitForEvent( int eventId );

// Waits for any of the specified flags to be set.
scriptEvent void waitForFlags( int flags );

// Prints the given string to the console.
scriptEvent void print( string text );

// Prints the given line to the console.
scriptEvent void println( string text );

// Prints this line in multiplayer.
scriptEvent void say( string text );

// Breaks if the condition is zero. (Only works in debug builds.)
scriptEvent void assert( float value );

// Triggers the given entity.
scriptEvent void trigger( entity ent, entity activator );

// Sets a cvar.
scriptEvent void setcvar( string name, string value );

// Returns the string for a cvar.
scriptEvent string getcvar( string name );

// Returns a random value X where 0 <= X < range.
scriptEvent float random( float range );

// Returns a random value X where 0 <= X < range.
scriptEvent int randomInt( int range );

// Returns the current game time in seconds.
scriptEvent float getTime();

// Sets the name of the current thread.
scriptEvent void setThreadName( string name );

// REturns the name of the current thread
scriptEvent string getThreadName();

// entity associated with this thread
scriptEvent void setThreadEntity( entity ent );

// returns the handle of the current thread
scriptEvent int getThreadHandle();

// Kills all threads with the specified name.
scriptEvent void killThread( string name );

// calls a the specified function using the entity's script object, using the entity's thread
scriptEvent void threadCall( entity ent, string functionName );

// Returns a reference to the entity with the specified name.
scriptEvent entity getEntity( string name );

// Creates an entity of the specified classname and returns a reference to the entity.
scriptEvent entity spawn( string classname );

// Returns a forward vector for the given Euler angles.
scriptEvent vector angToForward( vector ang );

// Returns a right vector for the given Euler angles.
scriptEvent vector angToRight( vector ang );

// Returns an up vector for the given Euler angles.
scriptEvent vector angToUp( vector ang );

// Returns the sine of the given angle in degrees.
scriptEvent float sin( float angle );

// Returns the cosine of the given angle in degrees.
scriptEvent float cos( float angle );

// Returns the tangent of the given angle in degrees.
scriptEvent float tan( float angle );

// Returns the arcsine of the given value in degrees.
scriptEvent float arcSin( float value );

// Returns the arccos of the given value in degrees.
scriptEvent float arcCos( float value );

// Returns the arctangent of the given value in degrees.
scriptEvent float arcTan( float value );

// Returns the arctangent of the given values in degrees.
scriptEvent float arcTan2( float y, float x );

// Returns the square root of the given number.
scriptEvent float sqrt( float theSquare );

// Returns the normalized version of the given vector.
scriptEvent vector vecNormalize( vector vec );

// Returns the length of the given vector.
scriptEvent float vecLength( vector vec );

// Returns the dot product of the two vectors.
scriptEvent float vecDotProduct( vector vec1, vector vec2 );

// Returns the cross product of the two vectors.
scriptEvent vector vecCrossProduct( vector vec1, vector vec2 );

// Returns Euler angles for the given direction.
scriptEvent vector vecToAngles( vector vec );

// Sets a script callback function for when the given signal is raised on the given entity.
scriptEvent void onSignal( int signal, entity ent, string func );

// Clears the script callback function set for when the given signal is raised on the given  entity.
scriptEvent void clearSignalThread( int signal, entity ent );

// Returns the fraction of movement completed before the box from 'mins' to 'maxs' hits  solid geometry when moving from 'start' to 'end'. The 'passEntity' is considered  non-solid during the move.
scriptEvent float trace( vector start, vector end, vector mins, vector maxs, int contents_mask, entity passEntity );

// Returns the fraction of movement completed before the trace hits solid geometry when  moving from 'start' to 'end'. The 'passEntity' is considered non-solid during the move.
scriptEvent float tracePoint( vector start, vector end, int contents_mask, entity passEntity );

// Returns the fraction of movement completed during the last call to trace or tracePoint.
scriptEvent float getTraceFraction();

// Returns the position the trace stopped due to a collision with solid geometry during the  last call to trace or tracePoint.
scriptEvent vector getTraceEndPos();

// Returns the normal vector of the hit plane during the last call to trace or tracePoint.
scriptEvent vector getTraceNormal();

// Returns a reference to the entity hit during the last call to trace or tracePoint.
scriptEvent entity getTraceEntity();

// Returns the namer of the skeletal joint closest to the location on the entity which was  hit during the last call to trace or tracePoint.
scriptEvent string getTraceJoint();

// Returns the name of the body part of the entity which was hit during the last call to  trace or tracePoint.
scriptEvent string getTraceBody();

// Create a decal
scriptEvent void spawnDecal( entity entityToAttachTo, vector pos, vector dir, vector size, float lifeTime, decl material );

// Starts playing background music.
scriptEvent void music( string name );

// Disables saving--forces player to wait to save his progress until enable-saves is called
scriptEvent void disableSaves();

// Enables saving--be sure to call once it's safe to save if you've called disable-saves.
scriptEvent void enableSaves();

// Issues a warning.
scriptEvent void warning( string text );

// Issues an error.
scriptEvent void error( string text );

// Returns the number of characters in the string.
scriptEvent int strLength( string string );

// Returns a string composed of the first num characters.
scriptEvent string strLeft( string string, int num );

// Returns a string composed of the last num characters.
scriptEvent string strRight( string string, int num );

// Returns the string following the first num characters.
scriptEvent string strSkip( string string, int num );

// Returns a string composed of the characters from start to start + num.
scriptEvent string strMid( string string, int start, int num );

// Returns the numeric value of a string.
scriptEvent float strToFloat( string string );

// Returns the numeric value of a string.
scriptEvent int strToInt( string string );

// Damages entities within a radius defined by the damageDef. Inflictor is the entity  causing the damage and can be the same as the attacker (in the case of projectiles, the  projectile is the inflictor, while the attacker is the character that fired the  projectile). Ignore is an entity to not cause damage to. dmgPower scales the damage (for  cases where damage is dependent on time).
scriptEvent void radiusDamage( vector origin, entity inflictor, entity attacker, entity ignore, string damageDefName, float dmgPower );

// Kills all entities of specified typ (any number of bit flags may be set)
scriptEvent void killByType( entity boundsEntity, int flags );

// Returns length of time between game frames. This is not related to renderer frame rate.
scriptEvent float getFrameTime();

// Returns the number of game frames per second. This is not related to renderer frame rate.
scriptEvent float getTicsPerSecond();

// Precaches the specified sound shader. Prevents cache hits when playing sound shaders.
scriptEvent void cacheSoundShader( string soundName );

// fades a specified sound group
scriptEvent void fadeSoundGroup( int groupNum, float toDB, float overSec );

// Draws a line for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugLine( vector color, vector start, vector end, float lifetime );

// Draws an arrow for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugArrow( vector color, vector start, vector end, int size, float lifetime );

// Draws a circle for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugCircle( vector color, vector origin, vector dir, float radius, int numSteps, float lifetime );

// Draws a bounding box for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugBounds( vector color, vector mins, vector maxs, float lifetime );

// Draws text for debug visualization. align can be 0-left, 1-center, 2-right.  lifetime of 0 == 1 frame.
scriptEvent void drawText( string text, vector origin, float scale, vector color, int align, float lifetime );

// returns the current map path in the format: maps/<subdir>/<mapname>/ useful for specifying paths for dynamically created func/statics with map models
scriptEvent string getMapPath();

// Creates a array entity and returns it
scriptEvent entity createArray();

// Destroys a array entity
scriptEvent void destroyArray( entity entity );

// Checks if entity is valid
scriptEvent boolean isEntityValid( entity entity );

// Checks if a layer is turned on
scriptEvent boolean isLayerActive( string layerName );

// Checks if a layer is available to be turned on
scriptEvent boolean isLayerDeactive( string layerName );

// halts game for debug... coder use only
scriptEvent void halt();

// Returns the name of a decl as a string
scriptEvent string getDeclName( decl decl );

// Returns true of the decl is non-NULL
scriptEvent boolean isValidDecl( decl decl );

// executes a console command
scriptEvent void executeCommandText( string command );

// Returns true if any player is incapacitated
scriptEvent boolean playerIsIncapacitated();

// Returns number of active AIs
scriptEvent int numActiveAIs();

