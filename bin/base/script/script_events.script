================================================
	idAnimatedEntity
================================================
*/

// Looks up the number of the specified joint. Returns INVALID_JOINT_HANDLE if the joint is not found.
scriptEvent int getJointHandle( string jointname );

// Modifies the position of the joint based on the transform type.
scriptEvent void setJointPos( int jointnum, int transform_type, vector pos );

// Modifies the orientation of the joint based on the transform type.
scriptEvent void setJointAngle( int jointnum, int transform_type, vector angles );

// Returns the position of the joint in world space.
scriptEvent vector getJointPos( int jointnum );

// Returns the angular orientation of the joint in world space.
scriptEvent vector getJointAngle( int jointnum );

// Start the fx with the specified condition
scriptEvent void startFX( int condition );

// Stop the fx with the specified condition
scriptEvent void stopFX( int condition );

